config {
  type: "table",
  schema: "intermediate",
  name: "int_attribution_journeys",
  tags: ["intermediate", "daily"],
  description: "Session-to-conversion journeys: one row per conversion event type, zero duplicates, ordered path arrays. Includes full ecommerce payload, UTM depth, click IDs, and privacy context.",
  assertions: {
    uniqueKey: ["user_pseudo_id", "conversion_ts", "conversion_event", "transaction_id"],
    nonNull: ["user_pseudo_id", "conversion_ts", "path_length"],
    rowConditions: [
      "conversion_value_usd >= 0",
      "path_length >= 1",
      "ARRAY_LENGTH(path) = path_length"
    ]
  }
}

-- Build ordered session journeys per conversion.
-- Each conversion appears exactly once. Sessions deduplicated within each path.
-- All ecommerce, UTM, click ID, and privacy fields preserved.
-- Supports multiple conversion_event types (purchase, begin_checkout, add_to_cart, etc.).

WITH conversion_sessions AS (
  SELECT
    c.user_pseudo_id,
    c.conversion_ts,
    c.conversion_event,
    c.event_date,
    c.platform,

    -- Conversion ecommerce payload
    c.transaction_id,
    c.purchase_revenue,
    c.purchase_revenue_in_usd,
    c.total_item_quantity,
    c.shipping_value,
    c.tax_value,
    c.refund_value,
    c.unique_items,
    -- c.coupon,  -- not available in public dataset; uncomment when migrating to private GA4 export
    c.items,
    c.event_value,
    c.event_currency,
    c.event_quantity,

    -- Context
    c.device_category,
    c.device_os,
    c.device_language,
    c.country,
    c.region,
    c.city,
    c.conversion_session_id,

    -- Session data (including new UTM depth, click IDs, page context, privacy)
    s.session_start,
    s.source,
    s.medium,
    s.campaign,
    s.content,
    s.term,
    s.channel,
    s.gclid,
    s.dclid,
    s.srsltid,
    s.msclkid,
    s.fbclid,
    s.ttclid,
    s.twclid,
    s.li_fat_id,
    s.page_location,
    s.page_referrer,
    s.hostname,
    s.user_first_touch_campaign,
    s.browser,
    s.browser_version,
    s.privacy_analytics_storage,
    s.privacy_ads_storage,
    s.privacy_uses_transient_token,

    -- Attribution window
    TIMESTAMP_DIFF(c.conversion_ts, s.session_start, HOUR) AS hours_before_conversion,

    -- Deduplicate sessions within the same user's journey
    ROW_NUMBER() OVER (
      PARTITION BY c.user_pseudo_id, c.conversion_ts, c.conversion_event, c.transaction_id, s.session_id
      ORDER BY s.session_start
    ) AS session_rn

  FROM ${ref("staging", "stg_ga4_conversions")} c
  LEFT JOIN ${ref("staging", "stg_ga4_sessions")} s
    ON c.user_pseudo_id = s.user_pseudo_id
    AND s.session_start <= c.conversion_ts
    AND TIMESTAMP_DIFF(c.conversion_ts, s.session_start, DAY) <= ${conversion_config.getLookbackCase('c.conversion_event')}
),
deduped_paths AS (
  SELECT *
  FROM conversion_sessions
  WHERE session_rn = 1
),
agg_journeys AS (
  SELECT
    user_pseudo_id,
    conversion_ts,
    conversion_event,
    event_date,
    platform,

    -- Ecommerce (single value per conversion)
    transaction_id,
    MAX(purchase_revenue) AS conversion_value_local,
    MAX(purchase_revenue_in_usd) AS conversion_value_usd,
    MAX(total_item_quantity) AS total_item_quantity,
    MAX(shipping_value) AS shipping_value,
    MAX(tax_value) AS tax_value,
    MAX(refund_value) AS refund_value,
    MAX(unique_items) AS unique_items,
    -- MAX(coupon) AS coupon,  -- not available in public dataset
    ANY_VALUE(items) AS items,
    MAX(event_value) AS event_value,
    MAX(event_currency) AS event_currency,
    MAX(event_quantity) AS event_quantity,

    -- Context
    MAX(device_category) AS device_category,
    MAX(device_os) AS device_os,
    MAX(device_language) AS device_language,
    MAX(country) AS country,
    MAX(region) AS region,
    MAX(city) AS city,
    MAX(conversion_session_id) AS conversion_session_id,

    -- Path array (ordered by session_start) with full UTM + click ID depth
    ARRAY_AGG(
      STRUCT(
        session_start,
        source,
        medium,
        campaign,
        content,
        term,
        channel,
        gclid,
        dclid,
        srsltid,
        msclkid,
        fbclid,
        ttclid,
        twclid,
        li_fat_id,
        page_location,
        page_referrer,
        hostname,
        user_first_touch_campaign,
        browser,
        browser_version,
        privacy_analytics_storage,
        privacy_ads_storage,
        privacy_uses_transient_token,
        hours_before_conversion
      )
      ORDER BY session_start
    ) AS path,

    COUNT(*) AS path_length,

    -- Stable conversion_id: globally unique per user
    ROW_NUMBER() OVER (
      PARTITION BY user_pseudo_id
      ORDER BY conversion_ts, conversion_event, COALESCE(transaction_id, '')
    ) AS user_conversion_seq

  FROM deduped_paths
  GROUP BY
    user_pseudo_id, conversion_ts, conversion_event, event_date, platform, transaction_id
)
SELECT
  *,
  -- Globally unique conversion_id for cross-user aggregation
  CONCAT(user_pseudo_id, '-', CAST(user_conversion_seq AS STRING)) AS conversion_id
FROM agg_journeys
