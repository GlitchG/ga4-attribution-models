config {
  type: "table",
  schema: "ecommerce_funnel",
  name: "cart_abandonment",
  tags: ["funnel", "daily"],
  description: "Cart abandonment analysis — session-scoped: users who added to cart in a session but did not complete purchase in that same session. NOTE: a user who adds to cart in session A and purchases in session B is counted as abandoned here. For user-level abandonment, join on user_pseudo_id only (omit conversion_session_id)."
}

WITH cart_sessions AS (
  SELECT DISTINCT user_pseudo_id, conversion_session_id
  FROM ${ref("staging", "stg_ga4_conversions")}
  WHERE conversion_event = 'add_to_cart'
),
purchase_sessions AS (
  SELECT DISTINCT user_pseudo_id, conversion_session_id
  FROM ${ref("staging", "stg_ga4_conversions")}
  WHERE conversion_event = 'purchase'
)
SELECT
  'add_to_cart' AS stage,
  COUNT(DISTINCT c.user_pseudo_id) AS users_with_cart,
  COUNT(DISTINCT c.conversion_session_id) AS sessions_with_cart,
  COUNT(DISTINCT p.user_pseudo_id) AS users_converted,
  COUNT(DISTINCT p.conversion_session_id) AS sessions_converted,
  ROUND(
    (COUNT(DISTINCT c.user_pseudo_id) - COUNT(DISTINCT p.user_pseudo_id)) * 100.0
    / NULLIF(COUNT(DISTINCT c.user_pseudo_id), 0), 2
  ) AS abandonment_rate_pct
FROM cart_sessions c
LEFT JOIN purchase_sessions p
  ON c.user_pseudo_id = p.user_pseudo_id
  AND c.conversion_session_id = p.conversion_session_id
