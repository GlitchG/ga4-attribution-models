config {
  type: "view",
  schema: "dashboard",
  name: "attribution_dashboard",
  tags: ["dashboard", "daily"],
  description: "Row-level attribution view for BI tools: one row per touchpoint per conversion per model. Aggregate in the BI tool by SUMming attributed_credit and attributed_value_usd, and COUNT(DISTINCT conversion_id) for conversion counts. For pre-aggregated channel-level metrics, point your BI tool at attribution_models.cross_channel_comparison instead — mixing row-level facts with pre-aggregated channel totals produces nonsensical numbers in Looker Studio."
}

SELECT
  m.model,
  m.conversion_event,
  ${conversion_config.getValueModeCase('m.conversion_event')} AS value_mode,
  m.channel,
  m.user_pseudo_id,
  m.conversion_id,
  m.conversion_ts,
  DATE(m.conversion_ts) AS conversion_date,
  m.transaction_id,
  m.conversion_value_local,
  m.conversion_value_usd,
  m.path_length,
  m.source,
  m.medium,
  m.campaign,
  m.attributed_credit,
  m.attributed_value_usd,
  m.attributed_value_local
FROM ${ref("attribution_models", "attribution_mart")} m
