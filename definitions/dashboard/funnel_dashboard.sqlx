config {
  type: "view",
  schema: "dashboard",
  name: "funnel_dashboard",
  tags: ["dashboard", "daily"],
  description: "Dashboard-ready ecommerce funnel metrics with abandonment rates. NOTE: UNION ALL matches by column position; ensure both SELECT lists have identical column order and types."
}

SELECT
  stage_num,
  stage,
  unique_users,
  unique_sessions,
  total_events,
  stage_revenue_usd,
  pct_of_top_users,
  pct_of_top_sessions,
  NULL AS abandonment_rate_pct
FROM ${ref("ecommerce_funnel", "purchase_funnel")}

UNION ALL

SELECT
  99 AS stage_num,
  stage,
  users_with_cart AS unique_users,
  sessions_with_cart AS unique_sessions,
  NULL AS total_events,
  NULL AS stage_revenue_usd,
  NULL AS pct_of_top_users,
  NULL AS pct_of_top_sessions,
  abandonment_rate_pct
FROM ${ref("ecommerce_funnel", "cart_abandonment")}
