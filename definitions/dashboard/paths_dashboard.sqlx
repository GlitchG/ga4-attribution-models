config {
  type: "view",
  schema: "dashboard",
  name: "paths_dashboard",
  tags: ["dashboard", "daily"],
  description: "Dashboard-ready view of user journey paths with conversion and revenue data."
}

SELECT
  user_pseudo_id,
  conversion_id,
  conversion_ts,
  conversion_event,
  transaction_id,
  conversion_value_local,
  conversion_value_usd,
  path_length,
  path,
  (
    SELECT STRING_AGG(channel, ' > ' ORDER BY session_start)
    FROM UNNEST(path)
  ) AS path_string,
  device_category,
  device_os,
  country,
  city
FROM ${ref("intermediate", "int_attribution_journeys")}
