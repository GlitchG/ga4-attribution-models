config {
  type: "incremental",
  schema: "staging",
  name: "stg_ga4_sessions",
  tags: ["staging", "daily"],
  description: "Deduplicated session-level extraction from GA4 events with GA4-UI-style source/medium resolution.",
  bigquery: {
    partitionBy: "DATE(session_start)",
    clusterBy: ["user_pseudo_id", "channel"],
    updatePartitionFilter: "session_start >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 3 DAY)"
  },
  assertions: {
    uniqueKey: ["user_pseudo_id", "session_id"],
    nonNull: ["user_pseudo_id", "session_id", "session_start", "channel"],
    rowConditions: [
      "session_start >= TIMESTAMP('2020-01-01')",
      "channel != ''"
    ]
  }
}

-- GA4-UI-style first-non-auto-event source extraction with session_start fallback.
-- Aligns source/medium with the GA4 UI Session Acquisition report.
-- Uses incremental partitioning for production cost control.

WITH session_event_traffic AS (
  SELECT
    user_pseudo_id,
    (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id') AS session_id,
    event_timestamp,
    event_name,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'source') AS source,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'medium') AS medium,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'campaign') AS campaign,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'content') AS content,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'term') AS term
  FROM ${ref("sources", "ga4_events")}
  WHERE _TABLE_SUFFIX
    ${when(incremental(),
      `BETWEEN FORMAT_DATE('%Y%m%d', DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY)) AND FORMAT_DATE('%Y%m%d', CURRENT_DATE())`,
      `BETWEEN '${dataform.projectConfig.vars.start_date}' AND '${dataform.projectConfig.vars.end_date}'`
    )}
    AND (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id') IS NOT NULL
),
session_traffic_resolved AS (
  SELECT
    user_pseudo_id,
    session_id,
    ${source_resolution.sourceResolutionLogic()} AS resolved_traffic
  FROM session_event_traffic
  GROUP BY 1, 2
),
deduped_sessions AS (
  SELECT
    user_pseudo_id,
    session_id,
    TIMESTAMP_MICROS(resolved_traffic.event_timestamp) AS session_start,
    COALESCE(resolved_traffic.source, '(direct)') AS source,
    COALESCE(resolved_traffic.medium, '(none)') AS medium,
    COALESCE(resolved_traffic.campaign, '') AS campaign,
    COALESCE(resolved_traffic.content, '') AS content,
    COALESCE(resolved_traffic.term, '') AS term,
    ${channel_grouping.channelGrouping('resolved_traffic.medium', 'resolved_traffic.source')} AS channel,
    ROW_NUMBER() OVER (PARTITION BY user_pseudo_id, session_id ORDER BY resolved_traffic.event_timestamp) AS rn
  FROM session_traffic_resolved
)
SELECT
  user_pseudo_id,
  session_id,
  session_start,
  source,
  medium,
  campaign,
  content,
  term,
  channel
FROM deduped_sessions
WHERE rn = 1
