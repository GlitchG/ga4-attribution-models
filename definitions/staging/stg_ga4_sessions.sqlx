config {
  type: "table",
  schema: "staging",
  name: "stg_ga4_sessions",
  tags: ["staging"],
  description: "Deduplicated session-level extraction from GA4 events. Source/medium resolution mode is controlled by the source_extraction_mode var: event_params (default, works on all exports), session_stslc (post-2024-07), collected (post-2023-06), or auto (COALESCE chain — requires export to have the newer fields).",
  columns: {
    user_pseudo_id: "GA4 user pseudo ID",
    session_id: "ga_session_id from event_params",
    session_start: "First event timestamp in the session",
    source: "Traffic source",
    medium: "Traffic medium",
    campaign: "Campaign name",
    content: "Ad content",
    term: "Search term",
    channel: "Normalised 19-channel grouping",
    device_category: "Device category",
    device_os: "Device operating system",
    country: "User country",
    city: "User city"
  }
}

WITH raw_events AS (
  SELECT
    user_pseudo_id,
    (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id') AS session_id,
    event_timestamp,
    event_name,

    -- Source/medium resolution (mode-dependent, injected at compile time)
    ${source_resolution.getSourceResolutionFrag()}

    -- Click IDs (mode-dependent)
    ${source_resolution.getClickIdFrag()}

    -- Other click IDs (always from event_params)
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'msclkid') AS msclkid,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'fbclid') AS fbclid,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'ttclid') AS ttclid,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'twclid') AS twclid,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'li_fat_id') AS li_fat_id,

    -- Page context
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'page_location') AS page_location,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'page_referrer') AS page_referrer,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key = 'hostname') AS hostname,

    -- Traffic source (user-level first touch — do NOT use for session attribution)
    traffic_source.name AS user_first_touch_campaign,

    -- Device context
    device.category AS device_category,
    device.operating_system AS device_os,
    device.language AS device_language,
    device.web_info.browser AS browser,
    device.web_info.browser_version AS browser_version,

    -- Geo context
    geo.country AS country,
    geo.region AS region,
    geo.city AS city,

    -- Privacy / consent mode v2 (conditional — 2020 public sample lacks these fields)
    ${source_resolution.getPrivacyFrag()}

  FROM `${constants.GA4_PROJECT}.${constants.GA4_DATASET}.events_*`
  WHERE _TABLE_SUFFIX BETWEEN
    FORMAT_DATE('%Y%m%d', DATE_SUB(PARSE_DATE('%Y%m%d', '${constants.START_DATE}'), INTERVAL ${conversion_config.getMaxLookback()} DAY))
    AND '${constants.END_DATE}'
    AND (SELECT value.int_value FROM UNNEST(event_params) WHERE key = 'ga_session_id') IS NOT NULL
    ${constants.getModeledEventsFilter()}
    AND TIMESTAMP_MICROS(event_timestamp) >= TIMESTAMP_SUB(
      TIMESTAMP(PARSE_DATE('%Y%m%d', '${constants.START_DATE}')),
      INTERVAL ${conversion_config.getMaxLookback()} DAY
    )
    AND TIMESTAMP_MICROS(event_timestamp) <= TIMESTAMP(PARSE_DATE('%Y%m%d', '${constants.END_DATE}'))
),
deduped_sessions AS (
  SELECT
    user_pseudo_id,
    session_id,
    TIMESTAMP_MICROS(event_timestamp) AS session_start,
    COALESCE(source, '(direct)') AS source,
    COALESCE(medium, '(none)') AS medium,
    COALESCE(campaign, '') AS campaign,
    COALESCE(content, '') AS content,
    COALESCE(term, '') AS term,
    ${channel_grouping.channelGrouping('COALESCE(medium, "(none)")', 'COALESCE(source, "(direct)")', 'COALESCE(campaign, "")')} AS channel,
    gclid,
    dclid,
    srsltid,
    msclkid,
    fbclid,
    ttclid,
    twclid,
    li_fat_id,
    page_location,
    page_referrer,
    hostname,
    user_first_touch_campaign,
    device_category,
    device_os,
    device_language,
    browser,
    browser_version,
    country,
    region,
    city,
    privacy_analytics_storage,
    privacy_ads_storage,
    privacy_uses_transient_token,
    ROW_NUMBER() OVER (PARTITION BY user_pseudo_id, session_id ORDER BY event_timestamp) AS rn
  FROM raw_events
)
SELECT
  user_pseudo_id,
  session_id,
  session_start,
  source,
  medium,
  campaign,
  content,
  term,
  channel,
  gclid,
  dclid,
  srsltid,
  msclkid,
  fbclid,
  ttclid,
  twclid,
  li_fat_id,
  page_location,
  page_referrer,
  hostname,
  user_first_touch_campaign,
  device_category,
  device_os,
  device_language,
  browser,
  browser_version,
  country,
  region,
  city,
  privacy_analytics_storage,
  privacy_ads_storage,
  privacy_uses_transient_token
FROM deduped_sessions
WHERE rn = 1
