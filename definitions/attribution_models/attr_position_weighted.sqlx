config {
  type: "table",
  schema: "attribution_models",
  name: "attr_position_weighted",
  tags: ["attribution", "model"],
  description: "Position-weighted attribution: 50% first, 30% last, 20% middle. Heuristic data-driven proxy."
}

WITH paths AS (
  SELECT
    *,
    CASE
      WHEN path_length = 1 THEN 1.0
      WHEN path_length = 2 AND session_position_asc = 1 THEN 0.6
      WHEN path_length = 2 AND session_position_desc = 1 THEN 0.4
      WHEN session_position_asc = 1 THEN 0.5
      WHEN session_position_desc = 1 THEN 0.3
      ELSE 0.2 / NULLIF(path_length - 2, 0)
    END AS credit
  FROM ${ref("intermediate", "int_attribution_path_rows")}
)
SELECT
  user_pseudo_id,
  conversion_id,
  conversion_ts,
  conversion_event,
  transaction_id,
  conversion_value_local,
  conversion_value_usd,
  path_length,
  source,
  medium,
  campaign,
  channel,
  'position_weighted' AS model,
  ROUND(credit, 4) AS attributed_credit,
  ${conversion_config.getValueExpr('conversion_event', 'conversion_value_usd', 'ROUND(credit, 4)')} AS attributed_value_usd,
  ${conversion_config.getValueExpr('conversion_event', 'conversion_value_local', 'ROUND(credit, 4)')} AS attributed_value_local
FROM paths
