config {
  type: "table",
  schema: "attribution_models",
  name: "attr_linear",
  tags: ["attribution", "model"],
  description: "Linear attribution: distributes credit equally across all sessions in the journey."
}

SELECT
  user_pseudo_id,
  conversion_id,
  conversion_ts,
  transaction_id,
  purchase_revenue,
  purchase_revenue_in_usd,
  path_length,
  source,
  medium,
  campaign,
  channel,
  'linear' AS model,
  ROUND(1.0 / path_length, 4) AS attributed_credit,
  ROUND(purchase_revenue_in_usd / path_length, 2) AS attributed_revenue,
  ROUND(purchase_revenue / path_length, 2) AS attributed_revenue_local
FROM ${ref("intermediate", "int_attribution_path_rows")}
