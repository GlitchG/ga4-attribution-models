config {
  type: "table",
  schema: "attribution_models",
  name: "attr_linear",
  tags: ["attribution", "model"],
  description: "Linear attribution: distributes credit equally across all sessions in the journey."
}

SELECT
  user_pseudo_id,
  conversion_id,
  conversion_ts,
  conversion_event,
  transaction_id,
  conversion_value_local,
  conversion_value_usd,
  path_length,
  source,
  medium,
  campaign,
  channel,
  'linear' AS model,
  ROUND(1.0 / path_length, 4) AS attributed_credit,
  ${conversion_config.getValueExpr('conversion_event', 'conversion_value_usd', 'ROUND(1.0 / path_length, 4)')} AS attributed_value_usd,
  ${conversion_config.getValueExpr('conversion_event', 'conversion_value_local', 'ROUND(1.0 / path_length, 4)')} AS attributed_value_local
FROM ${ref("intermediate", "int_attribution_path_rows")}
