config {
  type: "table",
  schema: "attribution_models",
  name: "attr_u_shape",
  tags: ["attribution", "model"],
  description: "U-shaped attribution: first and last touches share credit in a 40:40 ratio; remaining 20% is split equally among middle sessions. For single-session paths the session receives 100%. For two-session paths there are no middle sessions, so credit is normalised to 50%/50% (the 40:40 ratio, with zero middle weight). For three or more sessions: first = 40%, last = 40%, each middle = 20% / (path_length - 2)."
}

WITH paths AS (
  SELECT
    *,
    CASE
      WHEN path_length = 1 THEN 1.0
      WHEN path_length = 2 THEN 0.5
      WHEN session_position_asc = 1 THEN 0.4
      WHEN session_position_desc = 1 THEN 0.4
      ELSE 0.2 / NULLIF(path_length - 2, 0)
    END AS credit
  FROM ${ref("intermediate", "int_attribution_path_rows")}
)
SELECT
  user_pseudo_id,
  conversion_id,
  conversion_ts,
  conversion_event,
  transaction_id,
  conversion_value_local,
  conversion_value_usd,
  path_length,
  source,
  medium,
  campaign,
  channel,
  'u_shape' AS model,
  ROUND(credit, 4) AS attributed_credit,
  ${conversion_config.getValueExpr('conversion_event', 'conversion_value_usd', 'ROUND(credit, 4)')} AS attributed_value_usd,
  ${conversion_config.getValueExpr('conversion_event', 'conversion_value_local', 'ROUND(credit, 4)')} AS attributed_value_local
FROM paths
