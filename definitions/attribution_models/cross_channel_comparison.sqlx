config {
  type: "table",
  schema: "attribution_models",
  name: "cross_channel_comparison",
  tags: ["mart", "daily"],
  description: "Aggregated channel-level metrics across all attribution models and conversion events for side-by-side comparison. variance_from_last_click_usd is computed server-side via window function so Data Studio can use it directly without a calculated field."
}

-- Channel-level rollup comparing all attribution models.
-- conversion_id is globally unique (user_pseudo_id + seq), so COUNT DISTINCT is sufficient.
-- variance_from_last_click_usd uses a window function and must be in an outer query.

SELECT
  *,
  ROUND(
    total_value_usd
      - SUM(CASE WHEN model = 'last_click' THEN total_value_usd ELSE 0 END)
          OVER (PARTITION BY conversion_event, channel),
    2
  ) AS variance_from_last_click_usd
FROM (
  SELECT
    model,
    conversion_event,
    ${conversion_config.getValueModeCase('conversion_event')} AS value_mode,
    channel,
    COUNT(DISTINCT conversion_id) AS attributed_conversions,
    SUM(attributed_credit) AS total_credit,
    ROUND(SUM(attributed_value_usd), 2) AS total_value_usd,
    ROUND(SUM(attributed_value_local), 2) AS total_value_local,
    -- Named "avg_attributed_value" rather than "avg_order_value" because count-mode
    -- events (begin_checkout, add_to_cart, etc.) have NULL attributed_value, making
    -- "order value" semantically wrong for those rows.
    ROUND(SUM(attributed_value_usd) / NULLIF(SUM(attributed_credit), 0), 2) AS avg_attributed_value_usd,
    ROUND(SUM(attributed_value_local) / NULLIF(SUM(attributed_credit), 0), 2) AS avg_attributed_value_local
  FROM ${ref("attribution_models", "attribution_mart")}
  GROUP BY 1, 2, 3, 4
)
