config {
  type: "table",
  schema: "attribution_models",
  name: "cross_channel_comparison",
  tags: ["mart", "daily"],
  description: "Aggregated channel-level metrics across all attribution models and conversion events for side-by-side comparison."
}

-- Channel-level rollup comparing all attribution models.
-- conversion_id is globally unique (user_pseudo_id + seq), but for counting
-- attributed conversions we use COUNT(DISTINCT CONCAT(user_pseudo_id, '-', conversion_id))
-- to ensure cross-user uniqueness.

SELECT
  model,
  conversion_event,
  ${conversion_config.getValueModeCase('conversion_event')} AS value_mode,
  channel,
  COUNT(DISTINCT CONCAT(user_pseudo_id, '-', conversion_id)) AS attributed_conversions,
  SUM(attributed_credit) AS total_credit,
  ROUND(SUM(attributed_value_usd), 2) AS total_value_usd,
  ROUND(SUM(attributed_value_local), 2) AS total_value_local,
  ROUND(SUM(attributed_value_usd) / NULLIF(SUM(attributed_credit), 0), 2) AS avg_order_value_usd,
  ROUND(SUM(attributed_value_local) / NULLIF(SUM(attributed_credit), 0), 2) AS avg_order_value_local
FROM ${ref("attribution_models", "attribution_mart")}
GROUP BY 1, 2, 3, 4
