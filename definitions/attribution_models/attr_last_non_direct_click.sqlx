config {
  type: "table",
  schema: "attribution_models",
  name: "attr_last_non_direct_click",
  tags: ["attribution", "model"],
  description: "Last non-direct click attribution: assigns 100% credit to the last non-Direct session. Falls back to Direct if the entire path is Direct (no conversions are silently dropped)."
}

WITH ranked AS (
  SELECT
    *,
    ROW_NUMBER() OVER (
      PARTITION BY user_pseudo_id, conversion_id
      ORDER BY CASE WHEN channel != 'Direct' THEN 0 ELSE 1 END, session_position_desc
    ) AS rn
  FROM ${ref("intermediate", "int_attribution_path_rows")}
)
SELECT
  user_pseudo_id,
  conversion_id,
  conversion_ts,
  transaction_id,
  purchase_revenue,
  purchase_revenue_in_usd,
  path_length,
  source,
  medium,
  campaign,
  channel,
  'last_non_direct_click' AS model,
  1.0 AS attributed_credit,
  purchase_revenue_in_usd * 1.0 AS attributed_revenue,
  purchase_revenue * 1.0 AS attributed_revenue_local
FROM ranked
WHERE rn = 1
